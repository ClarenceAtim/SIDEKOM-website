# Contact form email delivery (SIDEKOM website)
# Copy these into Vercel: sidekom project -> Settings -> Environment Variables.
# Then redeploy (Deployments -> ... -> Redeploy) so the function picks them up.

# REQUIRED — Resend API key (free tier: 100 emails/day, 3,000/month).
# Create a free account at https://resend.com USING Contact@sidekom.com as the
# signup email, then Dashboard -> API Keys -> Create API Key (Sending access).
RESEND_API_KEY=

# Optional — override where form submissions go (default: Contact@sidekom.com).
# CONTACT_TO_EMAIL=Contact@sidekom.com

# Optional — override the sender shown on the email (default below).
# Without a verified domain in Resend, keep the onboarding@resend.dev sender:
# CONTACT_FROM_EMAIL=SIDEKOM Website <onboarding@resend.dev>
